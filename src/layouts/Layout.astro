---
import '../styles/global.css';
import { site } from '../data/content';
import Loader from '../components/Loader.astro';
import MusicButton from '../components/MusicButton.astro';

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9D%A4%EF%B8%8F%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffe6ec" />
    <meta name="description" content={site.description} />
    <title>{site.title}</title>
    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=DM+Sans:wght@400;500;600&family=Parisienne&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js', 'is-loading');
    </script>
  </head>
  <body>
    <Loader />
    <main>
      <slot />
    </main>
    <MusicButton />
    <script>
      import '../scripts/effects';
    </script>
  </body>
</html>
