---
import '../styles/global.css';
import { site, lock, og, deployUrl } from '../data/content';
import Lock from '../components/Lock.astro';
import Loader from '../components/Loader.astro';
import MusicButton from '../components/MusicButton.astro';

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%9D%A4%EF%B8%8F%3C/text%3E%3C/svg%3E";
const ogImage = `${deployUrl}${og.image}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffe6ec" />
    <meta name="description" content={site.description} />
    <title>{site.title}</title>

    <!-- Vista previa al compartir el link (WhatsApp, etc.): bonita, sin spoilers -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={deployUrl} />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={og.title} />
    <meta name="twitter:description" content={og.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=DM+Sans:wght@400;500;600&family=Parisienne&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ month: lock.month, day: lock.day }}>
      (function () {
        var root = document.documentElement;
        root.classList.add('js', 'is-loading');
        try {
          // limpia cualquier desbloqueo recordado de una versión anterior:
          // el candado ya no se acuerda entre recargas, solo la fecha real lo abre.
          localStorage.removeItem('valecita-unlocked');
          var now = new Date();
          var target = new Date(now.getFullYear(), month - 1, day, 0, 0, 0);
          if (now.getTime() < target.getTime()) root.classList.add('is-locked');
        } catch (e) {
          /* sin localStorage: se comporta igual, sin nada que limpiar */
        }
      })();
    </script>
  </head>
  <body>
    <Lock />
    <div class="site" data-site>
      <Loader />
      <main>
        <slot />
      </main>
      <MusicButton />
      <script>
        import '../scripts/effects';
      </script>
    </div>
  </body>
</html>
