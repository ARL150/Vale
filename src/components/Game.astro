---
import { game } from '../data/content';
---

<section class="section game" id="juego">
  <div class="container">
    <header class="game__head">
      <p class="eyebrow" data-reveal="fade">{game.eyebrow}</p>
      <h2 class="section-title" data-reveal="up" data-delay="100">{game.title}</h2>
    </header>

    <div
      class="arena glass"
      data-game
      data-config={JSON.stringify({
        levels: game.levels,
        texts: {
          start: game.start,
          next: game.next,
          retry: game.retry,
          again: game.again,
          levelDone: game.levelDone,
          levelFail: game.levelFail,
          win: game.win,
          hint: game.hint,
        },
      })}
      data-reveal="scale"
      data-delay="150"
    >
      <div class="hud" aria-live="off">
        <span>Nivel <b data-level>1</b>/{game.levels.length}</span>
        <span>💖 <b data-score>0</b>/<b data-goal>{game.levels[0].goal}</b></span>
        <span>⏱ <b data-time>{game.levels[0].time}</b>s</span>
      </div>

      <div class="progress" aria-hidden="true"><i data-progress></i></div>

      <canvas class="arena__canvas" data-canvas aria-label="Área del juego"></canvas>

      <div class="overlay" data-overlay>
        <p class="overlay__title" data-overlay-title>{game.hint}</p>

        <div class="coupon" data-coupon hidden>
          <span class="coupon__label">🎁 {game.prize.label}</span>
          <h3 class="coupon__title">{game.prize.title}</h3>
          <p class="coupon__text">{game.prize.text}</p>
          <span class="coupon__note">{game.prize.note}</span>
        </div>

        <button class="btn" type="button" data-play>{game.start}</button>
      </div>
    </div>
  </div>
</section>

<style>
  .game {
    background: linear-gradient(180deg, var(--cream) 0%, #fff0f3 60%, #ffe6ec 100%);
  }
  .game__head {
    text-align: center;
    margin-bottom: 2rem;
  }

  .arena {
    position: relative;
    height: min(74svh, 32rem);
    min-height: 26rem;
    overflow: hidden;
    padding: 0;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.85), rgba(255, 214, 224, 0.55));
    transition: box-shadow 0.3s;
  }
  .arena.is-hit {
    animation: shake 0.35s;
    box-shadow: 0 0 0 3px rgba(120, 30, 55, 0.35), var(--shadow-soft);
  }
  @keyframes shake {
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(3px);
    }
  }

  .hud {
    position: absolute;
    z-index: 2;
    top: 0.8rem;
    left: 0.7rem;
    right: 0.7rem;
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
    pointer-events: none;
  }
  .hud span {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    white-space: nowrap;
    color: var(--rose-600);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 6px 14px -8px rgba(201, 54, 87, 0.5);
  }
  .hud b {
    font-variant-numeric: tabular-nums;
  }

  /* barra de progreso hacia la meta del nivel */
  .progress {
    position: absolute;
    z-index: 2;
    top: 3.3rem;
    left: 0.9rem;
    right: 0.9rem;
    height: 6px;
    border-radius: 6px;
    background: rgba(201, 54, 87, 0.15);
    overflow: hidden;
    pointer-events: none;
  }
  .progress i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--gold), var(--rose-400), var(--rose-600));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out);
  }

  .arena__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    -webkit-user-select: none;
    user-select: none;
  }
  .arena.is-playing .arena__canvas {
    touch-action: none;
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: 1.3rem;
    text-align: center;
    background: rgba(255, 246, 248, 0.86);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: opacity 0.4s var(--ease-soft);
    overflow-y: auto;
  }
  .arena.is-playing .overlay {
    opacity: 0;
    pointer-events: none;
  }
  .overlay__title {
    max-width: 20rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.25rem, 5.2vw, 1.6rem);
    line-height: 1.25;
    color: var(--wine);
  }

  /* ── Cupón de premio ── */
  .coupon {
    position: relative;
    width: min(100%, 19rem);
    padding: 1.1rem 1.2rem 1rem;
    border-radius: 1.1rem;
    color: var(--wine);
    background: linear-gradient(150deg, #fffdf6, #fff0d2);
    border: 2px dashed var(--gold);
    box-shadow: 0 18px 34px -16px rgba(212, 168, 75, 0.7);
    animation: couponIn 0.9s var(--ease-out) both 0.3s;
  }
  .coupon[hidden] {
    display: none;
  }
  /* muescas laterales del boleto */
  .coupon::before,
  .coupon::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: -0.55rem;
    border-radius: 50%;
    background: #ffeff3;
    border: 2px dashed var(--gold);
  }
  .coupon::before {
    left: -0.6rem;
    clip-path: inset(0 0 0 50%);
  }
  .coupon::after {
    right: -0.6rem;
    clip-path: inset(0 50% 0 0);
  }
  .coupon__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .coupon__title {
    margin: 0.35rem 0;
    font-size: 1.7rem;
    font-style: italic;
    background: linear-gradient(120deg, var(--wine), var(--rose-600));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .coupon__text {
    font-size: 0.95rem;
    color: var(--ink);
    line-height: 1.45;
  }
  .coupon__note {
    display: block;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--muted);
    border-top: 1px dashed rgba(212, 168, 75, 0.7);
  }
  @keyframes couponIn {
    from {
      opacity: 0;
      transform: translateY(24px) rotate(-3deg) scale(0.9);
    }
  }
</style>

<script>
  import { confetti, confettiCannons, confettiRain } from '../scripts/confetti';

  interface Level {
    time: number;
    goal: number;
    speed: number;
    spawn: number;
    size: number;
    bad: number;
  }
  interface Item {
    x: number;
    y: number;
    vy: number;
    r: number;
    sway: number;
    phase: number;
    kind: 'heart' | 'gold' | 'bad';
    color: string;
  }
  interface Spark {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    color: string;
  }

  const arena = document.querySelector<HTMLElement>('[data-game]');

  if (arena) {
    const { levels, texts } = JSON.parse(arena.dataset.config!) as {
      levels: Level[];
      texts: Record<string, string>;
    };
    const canvas = arena.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const q = (s: string) => arena.querySelector<HTMLElement>(s)!;
    const levelEl = q('[data-level]');
    const scoreEl = q('[data-score]');
    const goalEl = q('[data-goal]');
    const timeEl = q('[data-time]');
    const progressEl = q('[data-progress]');
    const playBtn = q('[data-play]') as HTMLButtonElement;
    const overlayTitle = q('[data-overlay-title]');
    const coupon = q('[data-coupon]');

    const COLORS = ['#ff8aa6', '#e8506a', '#ff6f91', '#ffabc0'];
    let items: Item[] = [];
    let sparks: Spark[] = [];
    let w = 0;
    let h = 0;
    let dpr = 1;
    let levelIdx = 0;
    let score = 0;
    let elapsed = 0;
    let spawnIn = 0;
    let last = 0;
    let raf = 0;
    let playing = false;
    let hitTimer = 0;

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    new ResizeObserver(() => {
      resize();
      if (!playing) draw();
    }).observe(canvas);

    const heartPath = (x: number, y: number, s: number) => {
      ctx.beginPath();
      ctx.moveTo(x, y + s * 0.9);
      ctx.bezierCurveTo(x - s * 1.5, y - s * 0.1, x - s * 0.8, y - s * 1.1, x, y - s * 0.4);
      ctx.bezierCurveTo(x + s * 0.8, y - s * 1.1, x + s * 1.5, y - s * 0.1, x, y + s * 0.9);
      ctx.closePath();
    };
    const starPath = (x: number, y: number, s: number) => {
      ctx.beginPath();
      for (let i = 0; i < 10; i++) {
        const rad = i % 2 === 0 ? s * 1.15 : s * 0.5;
        const a = -Math.PI / 2 + (Math.PI / 5) * i;
        ctx.lineTo(x + Math.cos(a) * rad, y + Math.sin(a) * rad);
      }
      ctx.closePath();
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const it of items) {
        const x = it.x + Math.sin(it.phase) * it.sway;
        ctx.save();
        ctx.shadowColor = it.kind === 'gold' ? 'rgba(212,168,75,0.6)' : it.kind === 'bad' ? 'rgba(40,10,30,0.4)' : 'rgba(232,80,106,0.45)';
        ctx.shadowBlur = 10;
        ctx.fillStyle = it.color;
        if (it.kind === 'gold') starPath(x, it.y, it.r);
        else heartPath(x, it.y, it.r);
        ctx.fill();
        ctx.restore();
        if (it.kind === 'bad') {
          // grieta del corazón roto
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(x - it.r * 0.1, it.y - it.r * 0.5);
          ctx.lineTo(x + it.r * 0.25, it.y - it.r * 0.05);
          ctx.lineTo(x - it.r * 0.2, it.y + it.r * 0.25);
          ctx.lineTo(x + it.r * 0.1, it.y + it.r * 0.75);
          ctx.stroke();
        }
      }
      for (const s of sparks) {
        ctx.globalAlpha = Math.max(0, s.life);
        ctx.fillStyle = s.color;
        ctx.fillRect(s.x - 2, s.y - 2, 4, 4);
      }
      ctx.globalAlpha = 1;
    };

    const lv = () => levels[levelIdx];

    const spawn = () => {
      const L = lv();
      const roll = Math.random();
      const kind: Item['kind'] = roll < L.bad ? 'bad' : roll < L.bad + 0.13 ? 'gold' : 'heart';
      const r = (kind === 'gold' ? 17 : 15 + Math.random() * 8) * L.size;
      const ramp = 1 + (elapsed / L.time) * 0.25; // se acelera dentro del nivel
      items.push({
        x: r + 8 + Math.random() * (w - 2 * r - 16),
        y: -r * 2,
        vy: (100 + Math.random() * 70) * L.speed * ramp * (kind === 'gold' ? 1.25 : 1),
        r,
        sway: 6 + Math.random() * 16 * L.speed,
        phase: Math.random() * 6,
        kind,
        color: kind === 'gold' ? '#f0b93a' : kind === 'bad' ? '#3a1a2a' : COLORS[(Math.random() * COLORS.length) | 0],
      });
    };

    const burst = (x: number, y: number, color: string) => {
      for (let i = 0; i < 9; i++) {
        const a = Math.random() * Math.PI * 2;
        const v = 60 + Math.random() * 120;
        sparks.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, life: 1, color });
      }
    };

    const setScore = (v: number) => {
      score = Math.max(0, v);
      scoreEl.textContent = String(score);
      progressEl.style.transform = `scaleX(${Math.min(1, score / lv().goal)})`;
    };

    const frame = (now: number) => {
      const L = lv();
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      elapsed += dt;

      spawnIn -= dt;
      if (spawnIn <= 0) {
        spawn();
        spawnIn = Math.max(0.3, L.spawn - elapsed * 0.012) * (0.75 + Math.random() * 0.5);
      }

      items = items.filter((it) => {
        it.y += it.vy * dt;
        it.phase += dt * 2.2;
        return it.y < h + it.r * 2;
      });
      for (const s of sparks) {
        s.x += s.vx * dt;
        s.y += s.vy * dt;
        s.vy += 260 * dt;
        s.life -= dt * 2.2;
      }
      sparks = sparks.filter((s) => s.life > 0);

      timeEl.textContent = String(Math.max(0, Math.ceil(L.time - elapsed)));
      draw();

      if (score >= L.goal) return finish(true);
      if (elapsed >= L.time) return finish(false);
      raf = requestAnimationFrame(frame);
    };

    const showLevel = () => {
      levelEl.textContent = String(levelIdx + 1);
      goalEl.textContent = String(lv().goal);
      timeEl.textContent = String(lv().time);
      setScore(0);
    };

    const finish = (passed: boolean) => {
      playing = false;
      arena.classList.remove('is-playing');
      cancelAnimationFrame(raf);

      if (passed && levelIdx === levels.length - 1) {
        // 🏆 ¡Ganó todo!
        overlayTitle.textContent = texts.win;
        coupon.hidden = false;
        playBtn.textContent = texts.again;
        levelIdx = 0;
        confetti({ x: 0.5, y: 0.55, count: 120 });
        confettiCannons();
        confettiRain(3200);
      } else if (passed) {
        overlayTitle.textContent = `${texts.levelDone}`;
        playBtn.textContent = texts.next;
        levelIdx++;
        confetti({ x: 0.5, y: 0.6, count: 50, power: 0.8 });
      } else {
        overlayTitle.textContent = `${texts.levelFail} (${score}/${lv().goal})`;
        playBtn.textContent = texts.retry;
      }
    };

    const start = () => {
      resize();
      coupon.hidden = true;
      items = [];
      sparks = [];
      elapsed = 0;
      spawnIn = 0;
      showLevel();
      playing = true;
      arena.classList.add('is-playing');
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };

    playBtn.addEventListener('click', start);

    canvas.addEventListener('pointerdown', (e) => {
      if (!playing) return;
      const rect = canvas.getBoundingClientRect();
      const px = e.clientX - rect.left;
      const py = e.clientY - rect.top;
      for (let i = items.length - 1; i >= 0; i--) {
        const it = items[i];
        const x = it.x + Math.sin(it.phase) * it.sway;
        const reach = it.r * 1.3 + 12; // margen generoso para dedos
        if ((px - x) ** 2 + (py - it.y) ** 2 <= reach * reach) {
          items.splice(i, 1);
          burst(x, it.y, it.kind === 'bad' ? '#3a1a2a' : it.color);
          if (it.kind === 'bad') {
            setScore(score - 2);
            arena.classList.add('is-hit');
            clearTimeout(hitTimer);
            hitTimer = window.setTimeout(() => arena.classList.remove('is-hit'), 350);
          } else {
            setScore(score + (it.kind === 'gold' ? 3 : 1));
          }
          break;
        }
      }
    });

    resize();
    showLevel();

    // Si cambia de pestaña, la partida cuenta como intento fallido del nivel
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && playing) finish(false);
    });
  }
</script>
