---
import { gallery } from '../data/content';
---

<section class="section gallery" id="recuerdos">
  <div class="fx" data-hearts="6" data-sparks="8" aria-hidden="true"></div>

  <div class="container container--wide">
    <header class="gallery__head">
      <h2 class="section-title" data-reveal="up">{gallery.title}</h2>
      <p class="gallery__hint" data-reveal="fade" data-delay="200">{gallery.hint}</p>
    </header>

    <div class="gallery__grid">
      {
        gallery.photos.map((photo, i) => (
          <figure class="card" data-reveal={i % 2 === 0 ? 'left' : 'right'} data-delay={(i % 2) * 120}>
            <button class="polaroid" type="button" style={`--tilt:${i % 2 === 0 ? -2 : 2}deg`} data-photo aria-label={`Foto: ${photo.caption}`}>
              <span class="polaroid__img" style={`aspect-ratio:${photo.ratio}`}>
                <img src={photo.src} alt={photo.alt} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                <span class="polaroid__shine" aria-hidden="true"></span>
              </span>
              <figcaption>{photo.caption}</figcaption>
            </button>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    background: linear-gradient(180deg, var(--rose-50) 0%, #ffeef2 50%, var(--cream) 100%);
  }

  .gallery__head {
    text-align: center;
    margin-bottom: 2.6rem;
  }
  .gallery__hint {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* Dos columnas tipo "muro de recuerdos" en celular, tres en pantallas grandes */
  .gallery__grid {
    column-count: 2;
    column-gap: 0.9rem;
  }
  @media (min-width: 900px) {
    .gallery__grid {
      column-count: 3;
      column-gap: 1.6rem;
    }
  }

  .card {
    break-inside: avoid;
    margin-bottom: 1.1rem;
    /* evita que la tarjeta se parta entre columnas en Safari */
    -webkit-column-break-inside: avoid;
    display: block;
  }

  .polaroid {
    display: block;
    width: 100%;
    padding: 0.5rem 0.5rem 0.2rem;
    text-align: center;
    border-radius: 1.3rem;
    background: #fff;
    box-shadow: 0 14px 34px -16px rgba(120, 30, 55, 0.4);
    transform: rotate(var(--tilt));
    transition: transform 0.5s var(--ease-out);
    will-change: transform;
    position: relative;
    -webkit-user-select: none;
    user-select: none;
  }

  /* sombra grande que solo cambia de opacidad (barato de animar) */
  .polaroid::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 26px 46px -18px rgba(201, 54, 87, 0.55);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
    pointer-events: none;
  }
  .polaroid.is-active::after {
    opacity: 1;
  }

  .polaroid__img {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.95rem;
    background: var(--rose-100);
  }
  .polaroid__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  /* brillo que cruza la foto al tocarla */
  .polaroid__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.55) 50%, transparent 65%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  figcaption {
    padding: 0.65rem 0.3rem 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.2;
    color: var(--wine);
  }

  .polaroid.is-active {
    transform: rotate(0deg) scale(1.05);
    z-index: 3;
  }
  .polaroid.is-active img {
    transform: scale(1.07);
  }
  .polaroid.is-active .polaroid__shine {
    transform: translateX(120%);
    transition: transform 0.9s var(--ease-out);
  }

  @media (hover: hover) {
    .polaroid:hover {
      transform: rotate(0deg) translateY(-6px) scale(1.03);
    }
    .polaroid:hover::after {
      opacity: 1;
    }
    .polaroid:hover img {
      transform: scale(1.06);
    }
  }
  .polaroid:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
</style>

<script>
  import { popHearts } from '../scripts/effects';

  const photos = document.querySelectorAll<HTMLElement>('[data-photo]');

  photos.forEach((el) => {
    el.addEventListener('click', (e) => {
      const wasActive = el.classList.contains('is-active');
      photos.forEach((p) => p.classList.remove('is-active'));
      if (!wasActive) el.classList.add('is-active');

      const ev = e as MouseEvent;
      const r = el.getBoundingClientRect();
      // en teclado el evento trae coordenadas 0
      const x = ev.clientX || r.left + r.width / 2;
      const y = ev.clientY || r.top + r.height / 2;
      popHearts(x, y, 3);
    });
  });

  // Tocar fuera cierra la foto activa
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-photo]')) {
      photos.forEach((p) => p.classList.remove('is-active'));
    }
  });
</script>
