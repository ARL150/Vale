---
import { gallery } from '../data/content';
---

<section class="section gallery" id="recuerdos" data-gallery>
  <div class="fx" data-hearts="6" data-sparks="8" aria-hidden="true"></div>

  <div class="container container--wide">
    <header class="gallery__head">
      <h2 class="section-title" data-reveal="up">{gallery.title}</h2>
    </header>

    <!-- 🎁 Regalo: se agita y explota soltando todas las fotos -->
    <div class="giftbox-wrap" data-reveal="scale" data-delay="150">
      <div class="giftbox-clip">
        <div class="giftbox" data-giftbox>
          <button class="giftbox__tap" type="button" data-open-gift aria-label="Abrir regalo">
            <svg viewBox="0 0 200 200" width="180" height="180" aria-hidden="true">
              <defs>
                <linearGradient id="box1" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ff9bb3"></stop>
                  <stop offset="1" stop-color="#e8506a"></stop>
                </linearGradient>
                <linearGradient id="box2" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#fff0d2"></stop>
                  <stop offset="1" stop-color="#f4e0a9"></stop>
                </linearGradient>
              </defs>
              <rect x="24" y="88" width="152" height="92" rx="10" fill="url(#box1)"></rect>
              <rect x="24" y="88" width="152" height="18" fill="#00000014"></rect>
              <rect x="20" y="62" width="160" height="30" rx="8" fill="url(#box2)"></rect>
              <rect x="88" y="62" width="24" height="118" fill="#fff6f8" opacity=".85"></rect>
              <rect x="24" y="88" width="152" height="10" fill="#fff6f8" opacity=".7"></rect>
              <g class="giftbox__bow">
                <path d="M100 66c-10-26-46-30-52-8-4 16 20 20 52 10z" fill="#c93657"></path>
                <path d="M100 66c10-26 46-30 52-8 4 16-20 20-52 10z" fill="#e8506a"></path>
                <circle cx="100" cy="64" r="10" fill="#f4e0a9"></circle>
              </g>
            </svg>
          </button>
          <p class="giftbox__hint" data-giftbox-hint>{gallery.giftHint}</p>
        </div>
      </div>
    </div>

    <!-- Galería: se revela al abrir el regalo -->
    <div class="grid-wrap">
      <div class="grid-clip">
        <p class="gallery__hint" data-gallery-hint>{gallery.hint}</p>
        <div class="gallery__grid">
          {
            gallery.photos.map((photo, i) => (
              <figure class="card" style={`--i:${i}`}>
                <button class="polaroid" type="button" style={`--tilt:${i % 2 === 0 ? -2 : 2}deg`} data-photo aria-label={`Foto: ${photo.caption}`}>
                  <span class="polaroid__img" style={`aspect-ratio:${photo.ratio}`}>
                    <img src={photo.src} alt={photo.alt} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                    <span class="polaroid__shine" aria-hidden="true" />
                  </span>
                  <figcaption>{photo.caption}</figcaption>
                </button>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery {
    background: linear-gradient(180deg, var(--rose-50) 0%, #ffeef2 50%, var(--cream) 100%);
  }

  .gallery__head {
    text-align: center;
    margin-bottom: 1.6rem;
  }

  /* ── Caja de regalo ── */
  .giftbox-wrap {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.7s var(--ease-out) 0.5s, opacity 0.5s 0.5s;
  }
  .giftbox-clip {
    overflow: hidden;
    min-height: 0;
  }
  .gallery.is-open .giftbox-wrap {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .giftbox {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0 2.6rem;
  }
  .giftbox__tap {
    padding: 0;
    filter: drop-shadow(0 20px 22px rgba(201, 54, 87, 0.35));
    animation: giftFloat 3.6s ease-in-out infinite;
  }
  .giftbox__tap:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 6px;
    border-radius: 1rem;
  }
  .giftbox.is-shaking .giftbox__tap {
    animation: giftShake 0.7s ease-in-out;
  }
  .giftbox.is-popping .giftbox__tap {
    animation: giftPop 0.6s var(--ease-out) forwards;
  }
  .giftbox__bow {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @keyframes giftFloat {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(-1.5deg);
    }
  }
  @keyframes giftShake {
    0%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    10% {
      transform: rotate(-9deg) scale(1.03);
    }
    20% {
      transform: rotate(9deg) scale(1.03);
    }
    30% {
      transform: rotate(-11deg) scale(1.05);
    }
    40% {
      transform: rotate(11deg) scale(1.05);
    }
    50% {
      transform: rotate(-8deg) scale(1.04);
    }
    60% {
      transform: rotate(8deg) scale(1.04);
    }
    70% {
      transform: rotate(-5deg);
    }
    80% {
      transform: rotate(5deg);
    }
    90% {
      transform: rotate(-2deg);
    }
  }
  @keyframes giftPop {
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  .giftbox__hint {
    font-size: 0.95rem;
    color: var(--muted);
    text-align: center;
    transition: opacity 0.3s;
  }
  .giftbox.is-popping .giftbox__hint {
    opacity: 0;
  }

  /* ── Galería (oculta hasta abrir el regalo) ── */
  .grid-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.9s var(--ease-out) 0.35s;
  }
  .gallery.is-open .grid-wrap {
    grid-template-rows: 1fr;
  }
  .grid-clip {
    overflow: hidden;
    min-height: 0;
  }

  .gallery__hint {
    padding-top: 0.4rem;
    margin-bottom: 1.6rem;
    text-align: center;
    font-size: 0.95rem;
    color: var(--muted);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s var(--ease-out) 0.9s, transform 0.6s var(--ease-out) 0.9s;
  }
  .gallery.is-open .gallery__hint {
    opacity: 1;
    transform: none;
  }

  /* Dos columnas tipo "muro de recuerdos" en celular, tres en pantallas grandes */
  .gallery__grid {
    column-count: 2;
    column-gap: 0.9rem;
  }
  @media (min-width: 900px) {
    .gallery__grid {
      column-count: 3;
      column-gap: 1.6rem;
    }
  }

  .card {
    break-inside: avoid;
    margin-bottom: 1.1rem;
    -webkit-column-break-inside: avoid;
    display: block;
    /* estado "dentro de la caja": aparece en estallido cuando se abre el regalo */
    opacity: 0;
    transform: translate3d(0, 36px, 0) scale(0.78) rotate(calc((var(--i, 0) - 2) * 1.4deg));
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    transition-delay: calc(0.9s + var(--i, 0) * 55ms);
  }
  .gallery.is-open .card {
    opacity: 1;
    transform: none;
  }

  .polaroid {
    display: block;
    width: 100%;
    padding: 0.5rem 0.5rem 0.2rem;
    text-align: center;
    border-radius: 1.3rem;
    background: #fff;
    box-shadow: 0 14px 34px -16px rgba(120, 30, 55, 0.4);
    transform: rotate(var(--tilt));
    transition: transform 0.5s var(--ease-out);
    will-change: transform;
    position: relative;
    -webkit-user-select: none;
    user-select: none;
  }

  /* sombra grande que solo cambia de opacidad (barato de animar) */
  .polaroid::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 26px 46px -18px rgba(201, 54, 87, 0.55);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
    pointer-events: none;
  }
  .polaroid.is-active::after {
    opacity: 1;
  }

  .polaroid__img {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.95rem;
    background: var(--rose-100);
  }
  .polaroid__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  /* brillo que cruza la foto al tocarla */
  .polaroid__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.55) 50%, transparent 65%);
    transform: translateX(-120%);
    pointer-events: none;
  }

  figcaption {
    padding: 0.65rem 0.3rem 0.6rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.2;
    color: var(--wine);
  }

  .polaroid.is-active {
    transform: rotate(0deg) scale(1.05);
    z-index: 3;
  }
  .polaroid.is-active img {
    transform: scale(1.07);
  }
  .polaroid.is-active .polaroid__shine {
    transform: translateX(120%);
    transition: transform 0.9s var(--ease-out);
  }

  @media (hover: hover) {
    .polaroid:hover {
      transform: rotate(0deg) translateY(-6px) scale(1.03);
    }
    .polaroid:hover::after {
      opacity: 1;
    }
    .polaroid:hover img {
      transform: scale(1.06);
    }
  }
  .polaroid:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
</style>

<script>
  import { popHearts } from '../scripts/effects';
  import { confetti, confettiCannons } from '../scripts/confetti';

  const section = document.querySelector<HTMLElement>('[data-gallery]');
  const gift = document.querySelector<HTMLElement>('[data-giftbox]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-open-gift]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  openBtn?.addEventListener('click', () => {
    if (!section || !gift || section.classList.contains('is-open')) return;

    const burstAt = () => {
      const r = openBtn.getBoundingClientRect();
      const x = (r.left + r.width / 2) / window.innerWidth;
      const y = (r.top + r.height / 2) / window.innerHeight;
      confetti({ x, y, count: 130, power: 1.1 });
      confettiCannons();
    };

    if (reduce) {
      section.classList.add('is-open');
      burstAt();
      return;
    }

    gift.classList.add('is-shaking');
    setTimeout(() => {
      gift.classList.remove('is-shaking');
      gift.classList.add('is-popping');
      section.classList.add('is-open');
      burstAt();
    }, 700);
  });

  // ── Tocar una foto: la resalta y suelta corazones ──
  const photos = document.querySelectorAll<HTMLElement>('[data-photo]');

  photos.forEach((el) => {
    el.addEventListener('click', (e) => {
      const wasActive = el.classList.contains('is-active');
      photos.forEach((p) => p.classList.remove('is-active'));
      if (!wasActive) el.classList.add('is-active');

      const ev = e as MouseEvent;
      const r = el.getBoundingClientRect();
      // en teclado el evento trae coordenadas 0
      const x = ev.clientX || r.left + r.width / 2;
      const y = ev.clientY || r.top + r.height / 2;
      popHearts(x, y, 3);
    });
  });

  // Tocar fuera cierra la foto activa
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-photo]')) {
      photos.forEach((p) => p.classList.remove('is-active'));
    }
  });
</script>
