---
import { lock } from '../data/content';

const units: (keyof typeof lock.units)[] = ['days', 'hours', 'minutes', 'seconds'];
---

<div
  class="lock"
  data-lock
  data-month={lock.month}
  data-day={lock.day}
  data-hash={lock.passwordHash}
  data-messages={JSON.stringify(lock.wrongMessages)}
  aria-hidden="true"
>
  <div class="fx" data-hearts="12" data-sparks="18" aria-hidden="true"></div>
  <div class="lock__glow" aria-hidden="true"></div>
  <div class="lock__glow lock__glow--b" aria-hidden="true"></div>

  <!-- Mensaje emergente al fallar la contraseña -->
  <div class="lock-toast" data-lock-toast role="alert">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20.5S3.8 15.4 3.8 9.8C3.8 6.9 6 4.8 8.7 4.8c1.7 0 3.1.9 3.3 2 .2-1.1 1.6-2 3.3-2 2.7 0 4.9 2.1 4.9 5 0 5.6-8.2 10.7-8.2 10.7Z"></path>
      <path d="M9.5 9.5l5 5M14.5 9.5l-5 5"></path>
    </svg>
    <span data-lock-toast-text></span>
  </div>

  <div class="lock__panel glass">
    <div class="lock__badge">
      <div class="lock__ring" aria-hidden="true"></div>
      <div class="lock__icon" data-lock-icon aria-hidden="true">
        <svg viewBox="0 0 100 116" width="64" height="74">
          <defs>
            <linearGradient id="lockGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#ff8aa6"></stop>
              <stop offset="1" stop-color="#c93657"></stop>
            </linearGradient>
          </defs>
          <path class="lock__shackle" d="M32 52V36a18 18 0 0 1 36 0v16" fill="none" stroke="url(#lockGrad)" stroke-width="11" stroke-linecap="round"></path>
          <rect class="lock__body" x="18" y="48" width="64" height="58" rx="12" fill="url(#lockGrad)"></rect>
          <circle cx="50" cy="74" r="6.5" fill="#fff" opacity="0.9"></circle>
          <rect x="47" y="77" width="6" height="15" rx="3" fill="#fff" opacity="0.9"></rect>
        </svg>
      </div>
    </div>

    <p class="lock__eyebrow">Shhh...</p>
    <h1 class="lock__title">{lock.title}</h1>
    <p class="lock__subtitle">{lock.subtitle}</p>

    <div class="lock__countdown" data-lock-countdown>
      {
        units.map((u, i) => (
          <>
            <div class="lock__unit">
              <span class="lock__num" data-unit={u}>
                00
              </span>
              <span class="lock__unit-label">{lock.units[u]}</span>
            </div>
            {i < units.length - 1 && (
              <span class="lock__colon" aria-hidden="true">
                :
              </span>
            )}
          </>
        ))
      }
    </div>

    <div class="lock__divider" aria-hidden="true"><span></span></div>

    <form class="lock__form" data-lock-form autocomplete="off">
      <input
        class="lock__input"
        data-lock-input
        type="password"
        inputmode="numeric"
        pattern="[0-9]*"
        maxlength="6"
        placeholder={lock.placeholder}
        aria-label="Contraseña secreta"
        autocomplete="off"
      />
      <button class="btn" type="submit">{lock.button}</button>
    </form>
  </div>
</div>

<style>
  .lock {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    overflow: hidden;
    background: radial-gradient(90% 60% at 50% 0%, rgba(255, 255, 255, 0.9), transparent 70%), linear-gradient(165deg, #fff6f8 0%, #ffe6ec 52%, #fff1de 100%);
    transition: opacity 0.6s var(--ease-soft), visibility 0.6s;
  }

  .lock__glow {
    position: absolute;
    width: 24rem;
    height: 24rem;
    top: 6%;
    left: 50%;
    margin-left: -12rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 171, 192, 0.5), transparent 68%);
  }
  .lock__glow--b {
    top: auto;
    bottom: -6%;
    left: auto;
    right: -4rem;
    margin-left: 0;
    width: 18rem;
    height: 18rem;
    background: radial-gradient(circle, rgba(244, 224, 169, 0.55), transparent 68%);
  }

  /* ── Pop-up de contraseña incorrecta ── */
  .lock-toast {
    position: fixed;
    z-index: 6;
    top: calc(1.4rem + var(--safe-t));
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    max-width: calc(100% - 2.4rem);
    padding: 0.85rem 1.2rem;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(135deg, var(--rose-500), var(--wine) 130%);
    box-shadow: 0 18px 34px -12px rgba(74, 26, 40, 0.55);
    transform: translate(-50%, -140%) scale(0.92);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.5s var(--ease-out), opacity 0.4s;
  }
  .lock-toast svg {
    flex: none;
  }
  .lock-toast span {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .lock-toast.is-visible {
    transform: translate(-50%, 0) scale(1);
    opacity: 1;
  }
  .lock-toast.is-bump {
    animation: toastBump 0.35s var(--ease-out);
  }
  @keyframes toastBump {
    40% {
      transform: translate(-50%, 0) scale(1.06);
    }
  }

  .lock__panel {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 24rem;
    padding: 2.8rem 1.7rem 2.3rem;
    text-align: center;
    overflow: hidden;
  }
  /* filete dorado en el borde superior, para que no sea una glass card genérica */
  .lock__panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 12%;
    right: 12%;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    opacity: 0.8;
  }

  .lock__badge {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 6.5rem;
    height: 6.5rem;
    margin-bottom: 0.6rem;
  }
  .lock__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(255, 214, 224, 0.55) 70%, transparent 72%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    animation: ringPulse 2.6s ease-in-out infinite;
  }
  @keyframes ringPulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.08);
      opacity: 0.85;
    }
  }

  .lock__icon {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 10px 16px rgba(201, 54, 87, 0.35));
    animation: beat 2.2s ease-in-out infinite;
  }
  .lock__shackle {
    transform-box: fill-box;
    transform-origin: 100% 100%;
    transition: transform 0.6s var(--ease-out);
  }
  .lock.is-unlocking .lock__icon,
  .lock.is-unlocking .lock__ring {
    animation: none;
  }
  .lock.is-unlocking .lock__shackle {
    transform: translate(-3px, -9px) rotate(-32deg);
  }

  .lock__eyebrow {
    font-family: var(--font-script);
    font-size: 1.7rem;
    line-height: 1;
    color: var(--rose-500);
    margin-bottom: 0.3rem;
  }

  .lock__title {
    font-size: clamp(1.4rem, 6.2vw, 1.7rem);
    font-style: italic;
    color: var(--wine);
  }

  .lock__subtitle {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ── Contador: bloque oscuro tipo reloj digital ── */
  .lock__countdown {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    margin-top: 1.8rem;
    padding: 1.15rem 0.6rem;
    border-radius: 1.4rem;
    background: linear-gradient(165deg, #3a1220 0%, #200a13 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06), inset 0 0 0 1.5px rgba(255, 138, 166, 0.18), 0 18px 30px -16px rgba(32, 10, 19, 0.75);
    position: relative;
    overflow: hidden;
  }
  /* brillo que cruza el bloque de vez en cuando */
  .lock__countdown::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 40%, rgba(255, 255, 255, 0.1) 50%, transparent 60%);
    transform: translateX(-120%);
    animation: countdownShine 5s ease-in-out 1s infinite;
  }
  @keyframes countdownShine {
    0%,
    60% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }

  .lock__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.1rem;
    position: relative;
    z-index: 1;
  }
  .lock__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 7vw, 2rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #fff8f2;
    text-shadow: 0 0 14px rgba(255, 138, 166, 0.55);
    transition: transform 0.25s var(--ease-out);
  }
  .lock__num.is-tick {
    animation: numTick 0.35s var(--ease-out);
  }
  @keyframes numTick {
    0% {
      transform: translateY(-30%) scale(0.9);
      opacity: 0.4;
    }
    60% {
      transform: translateY(6%) scale(1.05);
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }
  .lock__unit-label {
    margin-top: 0.35rem;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }
  .lock__colon {
    align-self: flex-start;
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 5.5vw, 1.6rem);
    color: var(--rose-400);
    opacity: 0.85;
    position: relative;
    z-index: 1;
  }

  .lock__divider {
    display: flex;
    align-items: center;
    margin-top: 1.8rem;
  }
  .lock__divider span {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 54, 87, 0.2), transparent);
  }

  .lock__form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.4rem;
  }
  .lock__input {
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--rose-200);
    background: rgba(255, 255, 255, 0.85);
    text-align: center;
    font-size: 1.3rem;
    letter-spacing: 0.5em;
    color: var(--wine);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .lock__input:focus {
    outline: none;
    border-color: var(--rose-400);
    box-shadow: 0 0 0 4px rgba(255, 138, 166, 0.22);
  }
  .lock__input::placeholder {
    letter-spacing: 0.5em;
    color: var(--rose-200);
  }

  .lock.is-shaking .lock__panel {
    animation: lockShake 0.5s ease-in-out;
  }
  @keyframes lockShake {
    20% {
      transform: translateX(-8px);
    }
    40% {
      transform: translateX(8px);
    }
    60% {
      transform: translateX(-5px);
    }
    80% {
      transform: translateX(5px);
    }
  }

  .lock.is-unlocking .lock__panel {
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .lock.is-unlocking {
    opacity: 0;
    pointer-events: none;
  }
  .lock.is-unlocking .lock-toast {
    opacity: 0;
  }
  .lock.is-gone {
    visibility: hidden;
  }
</style>

<script>
  import { confetti, confettiCannons } from '../scripts/confetti';

  /** djb2: mismo hash que se usó para guardar la contraseña, así no aparece en texto plano. */
  function hash(str: string) {
    let h = 5381;
    for (let i = 0; i < str.length; i++) h = ((h << 5) + h + str.charCodeAt(i)) >>> 0;
    return h.toString(36);
  }

  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-lock]');

  // El desbloqueo por contraseña dura solo mientras la pestaña está abierta:
  // si recargas, vuelve a pedirla. Solo la fecha real la abre para siempre.
  const reached = () => {
    if (!el) return true;
    const now = new Date();
    const target = new Date(now.getFullYear(), Number(el.dataset.month) - 1, Number(el.dataset.day), 0, 0, 0);
    return now.getTime() >= target.getTime();
  };

  const finishUnlock = (celebrate: boolean) => {
    root.classList.remove('is-locked');
    window.dispatchEvent(new Event('site:unlocked'));
    if (!el) return;
    if (celebrate) {
      const r = el.querySelector('.lock__icon')?.getBoundingClientRect();
      if (r) {
        confetti({ x: (r.left + r.width / 2) / window.innerWidth, y: (r.top + r.height / 2) / window.innerHeight, count: 90 });
        confettiCannons();
      }
      el.classList.add('is-unlocking');
      setTimeout(() => el.classList.add('is-gone'), 650);
    } else {
      el.classList.add('is-gone');
    }
  };

  // La fecha ya llegó: no muestra nada.
  if (!el) {
    // sin candado en el DOM, nada que hacer
  } else if (reached()) {
    finishUnlock(false);
  } else {
    // ── Cuenta regresiva en vivo (con un pequeño rebote cuando cambia cada número) ──
    const nums = {
      days: el.querySelector<HTMLElement>('[data-unit="days"]')!,
      hours: el.querySelector<HTMLElement>('[data-unit="hours"]')!,
      minutes: el.querySelector<HTMLElement>('[data-unit="minutes"]')!,
      seconds: el.querySelector<HTMLElement>('[data-unit="seconds"]')!,
    };
    const setNum = (node: HTMLElement, value: string) => {
      if (node.textContent === value) return;
      node.textContent = value;
      node.classList.remove('is-tick');
      void node.offsetWidth;
      node.classList.add('is-tick');
    };
    const tick = () => {
      if (reached()) {
        finishUnlock(true);
        return;
      }
      const now = new Date();
      const target = new Date(now.getFullYear(), Number(el.dataset.month) - 1, Number(el.dataset.day), 0, 0, 0);
      const diff = Math.max(0, target.getTime() - now.getTime());
      const s = Math.floor(diff / 1000);
      setNum(nums.days, String(Math.floor(s / 86400)).padStart(2, '0'));
      setNum(nums.hours, String(Math.floor((s % 86400) / 3600)).padStart(2, '0'));
      setNum(nums.minutes, String(Math.floor((s % 3600) / 60)).padStart(2, '0'));
      setNum(nums.seconds, String(s % 60).padStart(2, '0'));
      setTimeout(tick, 1000 - (Date.now() % 1000));
    };
    tick();

    // ── Formulario de contraseña ──
    const form = el.querySelector<HTMLFormElement>('[data-lock-form]')!;
    const input = el.querySelector<HTMLInputElement>('[data-lock-input]')!;
    const toast = el.querySelector<HTMLElement>('[data-lock-toast]')!;
    const toastText = el.querySelector<HTMLElement>('[data-lock-toast-text]')!;
    const messages: string[] = JSON.parse(el.dataset.messages || '[]');
    let lastMessage = '';
    let toastTimer = 0;

    const nextMessage = () => {
      if (messages.length <= 1) return messages[0] ?? 'Contraseña incorrecta';
      let msg = messages[(Math.random() * messages.length) | 0];
      while (msg === lastMessage) msg = messages[(Math.random() * messages.length) | 0];
      lastMessage = msg;
      return msg;
    };

    const popToast = (msg: string) => {
      toastText.textContent = msg;
      clearTimeout(toastTimer);
      if (toast.classList.contains('is-visible')) {
        // ya estaba mostrándose: solo un pequeño "brinco" para que se note el nuevo intento
        toast.classList.remove('is-bump');
        void toast.offsetWidth;
        toast.classList.add('is-bump');
      } else {
        toast.classList.add('is-visible');
      }
      toastTimer = window.setTimeout(() => toast.classList.remove('is-visible', 'is-bump'), 2700);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (value && hash(value) === el.dataset.hash) {
        toast.classList.remove('is-visible', 'is-bump');
        finishUnlock(true);
        return;
      }
      popToast(nextMessage());
      el.classList.remove('is-shaking');
      // fuerza un reflow para poder repetir la animación en intentos seguidos
      void el.offsetWidth;
      el.classList.add('is-shaking');
      input.value = '';
      input.focus();
    });
  }
</script>
