---
import { letter } from '../data/content';
---

<section class="section letter" id="carta">
  <div class="fx" data-sparks="10" aria-hidden="true"></div>

  <div class="container">
    <h2 class="section-title letter__title" data-reveal="up">{letter.title}</h2>

    <div class="stage" data-letter data-reveal="scale" data-delay="150">
      <div class="envelope" aria-hidden="true">
        <div class="envelope__back"></div>
        <div class="envelope__flap"></div>
        <div class="envelope__front"></div>
        <span class="envelope__seal">❤</span>
      </div>

      <div class="paper-wrap" id="letter-paper">
        <div class="paper-clip">
          <article class="paper" aria-label="Carta">
            <p class="paper__greeting line" style="--i:0">{letter.greeting}</p>
            {
              letter.paragraphs.map((p, i) => (
                <p class="paper__p line" style={`--i:${i + 1}`}>
                  {p}
                </p>
              ))
            }
            <p class="paper__closing line" style={`--i:${letter.paragraphs.length + 1}`}>{letter.closing}</p>
            <p class="paper__sign line" style={`--i:${letter.paragraphs.length + 2}`}>{letter.signature}</p>
          </article>
        </div>
      </div>

      <div class="letter__action">
        <button class="btn" type="button" data-open-letter aria-expanded="false" aria-controls="letter-paper">
          {letter.button}
        </button>
        <p class="letter__hint">{letter.hint}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .letter {
    background: linear-gradient(180deg, var(--wine-deep) 0%, #b9647a 6%, var(--rose-100) 20%, var(--cream) 100%);
    padding-top: clamp(7rem, 20vw, 10rem);
  }

  .letter__title {
    text-align: center;
    margin-bottom: 2.4rem;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    perspective: 1000px;
  }

  /* ── Sobre ── */
  .envelope {
    position: relative;
    z-index: 3;
    width: min(100%, 20rem);
    aspect-ratio: 8 / 5;
    filter: drop-shadow(0 22px 26px rgba(120, 30, 55, 0.3));
  }
  .envelope__back,
  .envelope__front,
  .envelope__flap {
    position: absolute;
    inset: 0;
    border-radius: 0.9rem;
  }
  .envelope__back {
    background: linear-gradient(160deg, #f3b6c5, #e58ba1);
  }
  .envelope__front {
    background: linear-gradient(170deg, #ffe0e8, #ffc4d3);
    clip-path: polygon(0 0, 50% 58%, 100% 0, 100% 100%, 0 100%);
    border-radius: 0.9rem;
  }
  .envelope__flap {
    height: 60%;
    bottom: auto;
    background: linear-gradient(180deg, #ffd0dc, #ffb2c5);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform-origin: top center;
    transition: transform 0.9s var(--ease-out), z-index 0s 0.35s;
    z-index: 3;
    backface-visibility: hidden;
  }
  .envelope__seal {
    position: absolute;
    z-index: 4;
    top: 58%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    margin: -1.35rem 0 0 -1.35rem;
    border-radius: 50%;
    color: #fff;
    font-size: 1.15rem;
    background: radial-gradient(circle at 35% 30%, #ff8aa6, #c93657);
    box-shadow: 0 6px 14px -4px rgba(120, 20, 45, 0.6);
    transition: opacity 0.4s, transform 0.6s var(--ease-out);
    animation: beat 2s ease-in-out infinite;
  }

  .stage.is-open .envelope__flap {
    transform: rotateX(180deg);
    z-index: 0;
  }
  .stage.is-open .envelope__seal {
    opacity: 0;
    transform: scale(0.4);
  }

  /* ── Carta que sale del sobre ── */
  .paper-wrap {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: 0fr;
    width: 100%;
    margin-top: -2.4rem;
    transition: grid-template-rows 1.1s var(--ease-out) 0.35s;
  }
  .stage.is-open .paper-wrap {
    grid-template-rows: 1fr;
  }
  .paper-clip {
    overflow: hidden;
    min-height: 0;
    /* espacio para la sombra sin recortarla */
    padding-inline: 0.2rem;
  }

  .paper {
    position: relative;
    margin-top: 2.4rem;
    padding: 2rem 1.5rem 1.8rem;
    border-radius: 0.5rem 0.5rem 1.3rem 1.3rem;
    text-align: left;
    color: var(--ink);
    background:
      repeating-linear-gradient(180deg, transparent 0 1.85rem, rgba(232, 80, 106, 0.09) 1.85rem 1.9rem),
      linear-gradient(180deg, #fffdf8, #fff6ea);
    box-shadow: 0 24px 40px -22px rgba(120, 30, 55, 0.5);
    transform: translate3d(0, -40px, 0);
    opacity: 0;
    transition: transform 1s var(--ease-out) 0.4s, opacity 0.6s 0.4s;
  }
  .paper::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 1rem;
    width: 1px;
    background: rgba(232, 80, 106, 0.22);
  }
  .stage.is-open .paper {
    transform: none;
    opacity: 1;
  }

  .paper p {
    font-family: var(--font-display);
    font-size: clamp(1.18rem, 4.8vw, 1.35rem);
    font-weight: 500;
    line-height: 1.6;
  }
  .paper p + p {
    margin-top: 0.9rem;
  }
  .paper__greeting {
    font-family: var(--font-script) !important;
    font-size: clamp(1.9rem, 8vw, 2.4rem) !important;
    color: var(--rose-500);
    line-height: 1.2 !important;
  }
  .paper__closing {
    margin-top: 1.4rem !important;
    font-style: italic;
  }
  .paper__sign {
    font-family: var(--font-script) !important;
    font-size: 1.9rem !important;
    color: var(--rose-500);
  }

  /* Las líneas aparecen escalonadas al abrirse */
  .line {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }
  .stage.is-open .line {
    opacity: 1;
    transform: none;
    transition-delay: calc(1.1s + var(--i) * 0.28s);
  }

  /* ── Botón ── */
  .letter__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
    transition: opacity 0.5s, transform 0.5s var(--ease-out), height 0.6s;
  }
  .letter__hint {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .stage.is-open .letter__action {
    display: none;
  }
</style>

<script>
  import { confetti } from '../scripts/confetti';

  const stage = document.querySelector<HTMLElement>('[data-letter]');
  const btn = document.querySelector<HTMLButtonElement>('[data-open-letter]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  btn?.addEventListener('click', () => {
    if (!stage || stage.classList.contains('is-open')) return;
    const r = btn.getBoundingClientRect();
    stage.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');

    confetti({
      x: (r.left + r.width / 2) / window.innerWidth,
      y: (r.top + r.height / 2) / window.innerHeight,
      count: 45,
      power: 0.8,
    });

    // Lleva la carta a la vista cuando termina de abrirse
    const paper = stage.querySelector<HTMLElement>('.paper');
    setTimeout(() => paper?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }), 900);
  });
</script>
