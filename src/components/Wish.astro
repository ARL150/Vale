---
import { wish } from '../data/content';
---

<section class="section wish" id="deseo" data-wish>
  <div class="fx" data-sparks="18" aria-hidden="true"></div>
  <div class="wish__glow" aria-hidden="true"></div>

  <div class="container wish__inner">
    <p class="eyebrow" data-reveal="fade">{wish.eyebrow}</p>
    <h2 class="section-title" data-reveal="up" data-delay="100">{wish.title}</h2>

    <button class="cake" type="button" data-cake aria-label="Soplar las velas" data-reveal="scale" data-delay="250">
      <svg viewBox="0 0 240 240" width="240" height="240" aria-hidden="true">
        <defs>
          <linearGradient id="c1" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff"></stop>
            <stop offset="1" stop-color="#ffd6e0"></stop>
          </linearGradient>
          <linearGradient id="c2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ff8aa6"></stop>
            <stop offset="1" stop-color="#e8506a"></stop>
          </linearGradient>
        </defs>
        <ellipse cx="120" cy="222" rx="104" ry="11" fill="#c93657" opacity=".16"></ellipse>
        <rect x="18" y="190" width="204" height="28" rx="14" fill="#f4e0a9"></rect>
        <rect x="34" y="128" width="172" height="66" rx="16" fill="url(#c2)"></rect>
        <path d="M34 146c14 10 22-6 36 4s22-8 36 2 22-8 36 2 22-6 36 4 20-2 28 0v-20H34z" fill="url(#c1)"></path>
        <rect x="58" y="86" width="124" height="46" rx="14" fill="url(#c1)"></rect>
        <path d="M58 104c12 9 20-5 32 3s20-7 32 1 20-7 32 1 20-4 28 2v-8H58z" fill="#ffabc0"></path>
        <g fill="#d4a84b">
          <circle cx="70" cy="170" r="4"></circle>
          <circle cx="106" cy="176" r="4"></circle>
          <circle cx="142" cy="170" r="4"></circle>
          <circle cx="176" cy="176" r="4"></circle>
        </g>
        {
          [88, 120, 152].map((x, i) => (
            <g class="candle" style={`--i:${i}`}>
              <rect x={x - 4} y="52" width="8" height="36" rx="3" fill="#ffe9a8" stroke="#d4a84b" stroke-width="1.5"></rect>
              <path class="flame" d={`M${x} 26c7 8 9 14 0 24-9-10-7-16 0-24z`} fill="#ffb648"></path>
              <path class="flame-in" d={`M${x} 34c3 4 4 7 0 12-4-5-3-8 0-12z`} fill="#fff3c4"></path>
              <circle class="smoke" cx={x} cy="40" r="4" fill="#fff" opacity="0"></circle>
            </g>
          ))
        }
      </svg>
    </button>

    <p class="wish__hint" data-wish-hint data-reveal="fade" data-delay="400">{wish.hint}</p>
    <p class="wish__done" data-wish-done aria-live="polite">{wish.done}</p>

    <button class="btn" type="button" data-wish-btn data-reveal="up" data-delay="500" data-label={wish.button} data-again={wish.again}>
      {wish.button}
    </button>
  </div>
</section>

<style>
  .wish {
    text-align: center;
    background: linear-gradient(180deg, var(--cream) 0%, #ffeef2 55%, #ffe6ec 100%);
    padding-bottom: clamp(6rem, 18vw, 9rem);
  }
  .wish__glow {
    position: absolute;
    width: 26rem;
    height: 26rem;
    top: 22%;
    left: 50%;
    margin-left: -13rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 190, 90, 0.35), transparent 66%);
    transition: opacity 1s;
  }
  .wish.is-out .wish__glow {
    opacity: 0.25;
  }

  .wish__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cake {
    margin: 2rem 0 0.4rem;
    padding: 0;
    filter: drop-shadow(0 22px 22px rgba(201, 54, 87, 0.28));
    transition: transform 0.4s var(--ease-out);
    animation: float 4.5s ease-in-out infinite;
  }
  .cake:active {
    transform: scale(0.96);
  }
  .cake:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 6px;
    border-radius: 1.5rem;
  }
  .cake svg {
    max-width: 100%;
    height: auto;
    overflow: visible;
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .flame,
  .flame-in {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: flicker 0.9s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.25s);
    transition: opacity 0.4s;
  }
  .candle:nth-child(1) .flame,
  .candle:nth-child(1) .flame-in {
    animation-delay: 0s;
  }
  @keyframes flicker {
    0%,
    100% {
      transform: scale(1, 1) rotate(-2deg);
    }
    35% {
      transform: scale(0.92, 1.1) rotate(2deg);
    }
    70% {
      transform: scale(1.05, 0.94) rotate(-1deg);
    }
  }

  .wish.is-out .flame,
  .wish.is-out .flame-in {
    opacity: 0;
    animation: none;
  }
  .wish.is-out .smoke {
    animation: smoke 1.8s var(--ease-out) forwards;
    transform-box: fill-box;
    transform-origin: center;
  }
  .wish.is-out .candle:nth-child(2) .smoke {
    animation-delay: 0.12s;
  }
  .wish.is-out .candle:nth-child(3) .smoke {
    animation-delay: 0.24s;
  }
  @keyframes smoke {
    0% {
      opacity: 0.8;
      transform: translateY(0) scale(0.6);
    }
    100% {
      opacity: 0;
      transform: translateY(-46px) scale(2.4);
    }
  }

  .wish__hint {
    max-width: 18rem;
    margin-bottom: 1.6rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .wish__done {
    display: none;
    max-width: 20rem;
    margin-bottom: 1.6rem;
    font-family: var(--font-script);
    font-size: clamp(1.8rem, 7.5vw, 2.4rem);
    line-height: 1.25;
    color: var(--rose-600);
  }
  .wish.is-out .wish__hint {
    display: none;
  }
  .wish.is-out .wish__done {
    display: block;
    animation: fadeUp 1s var(--ease-out) both;
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>

<script>
  import { confetti } from '../scripts/confetti';

  const section = document.querySelector<HTMLElement>('[data-wish]');
  const cake = document.querySelector<HTMLElement>('[data-cake]');
  const btn = document.querySelector<HTMLButtonElement>('[data-wish-btn]');

  const toggle = () => {
    if (!section || !btn) return;
    const out = !section.classList.contains('is-out');
    section.classList.toggle('is-out', out);
    btn.textContent = out ? btn.dataset.again! : btn.dataset.label!;
    if (out) {
      const r = (cake ?? btn).getBoundingClientRect();
      confetti({ x: (r.left + r.width / 2) / window.innerWidth, y: (r.top + r.height * 0.2) / window.innerHeight, count: 70 });
    }
  };

  cake?.addEventListener('click', () => {
    if (!section?.classList.contains('is-out')) toggle();
  });
  btn?.addEventListener('click', toggle);
</script>
