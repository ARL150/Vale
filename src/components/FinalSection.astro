---
import { finale, revisit } from '../data/content';

// El emoji va fuera del degradado para conservar su color
const [titleText, ...rest] = finale.title.split('❤');
const hasHeart = rest.length > 0;

// Trazos SVG por ícono (nunca emoji): mail, photo, book, star, game, heart
const ICON_PATHS: Record<string, string> = {
  mail: 'M3 5.5h18v13H3v-13Zm0 0 9 7 9-7',
  photo: 'M3.5 5.5h17v13h-17v-13Zm4 5.2a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM4 18l5.5-5.5 3 3L18 10l2.5 2.5',
  book: 'M4 5.6C4 4.7 4.7 4 5.6 4H12v16H5.6A1.6 1.6 0 0 1 4 18.4V5.6ZM20 5.6c0-.9-.7-1.6-1.6-1.6H12v16h6.4a1.6 1.6 0 0 0 1.6-1.6V5.6Z',
  star: 'M12 3.3l2.7 5.9 6.3.6-4.8 4.3 1.4 6.3L12 17.1l-5.6 3.3 1.4-6.3-4.8-4.3 6.3-.6L12 3.3Z',
  game: 'M6.5 8h11a3.5 3.5 0 0 1 3.4 4.3l-.7 3a2.4 2.4 0 0 1-4.2 1L14.5 15h-5L8 16.3a2.4 2.4 0 0 1-4.2-1l-.7-3A3.5 3.5 0 0 1 6.5 8Zm1 3v2.6M6.2 12.3h2.6M15.8 11.3h.01M17.8 13.3h.01',
  heart: 'M12 20.5S3.8 15.4 3.8 9.8C3.8 6.9 6 4.8 8.7 4.8c1.7 0 3.1.9 3.3 2h0c.2-1.1 1.6-2 3.3-2 2.7 0 4.9 2.1 4.9 5 0 5.6-8.2 10.7-8.2 10.7Z',
};
---

<section class="section final" id="final" data-final>
  <div class="fx" data-hearts="22" data-sparks="24" aria-hidden="true"></div>

  <div class="container final__inner">
    <button class="final__heart" type="button" data-reveal="scale" data-final-heart aria-label="Lanzar confeti">
      <svg viewBox="0 0 24 24" width="96" height="96" aria-hidden="true">
        <defs>
          <linearGradient id="fg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff8aa6"></stop>
            <stop offset="1" stop-color="#c93657"></stop>
          </linearGradient>
        </defs>
        <path fill="url(#fg)" d="M12 21s-7-4.6-9.3-9C.9 8.4 2.7 5 6 5c2 0 3.4 1 4.1 2.3h3.8C14.6 6 16 5 18 5c3.3 0 5.1 3.4 3.3 7-2.3 4.4-9.3 9-9.3 9z"></path>
      </svg>
    </button>
    <p class="final__tap" data-reveal="fade" data-delay="300">{finale.tapHint}</p>

    <h2 class="final__title" data-reveal="up" data-delay="200" aria-label={finale.title}>
      <span class="final__grad">{titleText.trim()}</span>{hasHeart && <span class="final__emoji"> ❤️</span>}
    </h2>
    <p class="final__sub" data-reveal="up" data-delay="500">{finale.subtitle}</p>

    <div class="revisit" data-reveal="up" data-delay="620">
      <p class="revisit__title">{revisit.title}</p>
      <nav class="revisit__grid">
        {
          revisit.items.map((item) => (
            <button class="revisit__item" type="button" data-scroll-to={item.href} aria-label={item.label}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={ICON_PATHS[item.icon]} />
              </svg>
              <span>{item.label}</span>
            </button>
          ))
        }
      </nav>
    </div>

    <button class="btn btn--ghost final__top" type="button" data-scroll-to="top" data-reveal="up" data-delay="780">
      {finale.backToTop}
    </button>
  </div>
</section>

<style>
  .final {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    background:
      radial-gradient(70% 45% at 50% 35%, rgba(255, 255, 255, 0.85), transparent 70%),
      linear-gradient(180deg, var(--cream) 0%, #ffe0e8 45%, #ffbccd 100%);
    padding-bottom: calc(6rem + var(--safe-b));
  }

  .final__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final__heart {
    padding: 0.5rem;
    border-radius: 50%;
    filter: drop-shadow(0 16px 24px rgba(201, 54, 87, 0.4));
    animation: beat 1.7s ease-in-out infinite;
  }
  .final__heart:active {
    transform: scale(0.88);
  }
  .final__heart:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }

  .final__tap {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .final__title {
    margin-top: 2rem;
    font-size: clamp(2.7rem, 12.5vw, 5.2rem);
    font-style: italic;
    line-height: 1.05;
    padding: 0 0.05em 0.12em;
  }
  .final__grad {
    background: linear-gradient(120deg, var(--wine) 25%, var(--rose-600) 70%, var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .final__emoji {
    display: inline-block;
    animation: beat 1.7s ease-in-out infinite;
  }

  .final__sub {
    margin-top: 1rem;
    font-family: var(--font-script);
    font-size: clamp(2rem, 9vw, 3rem);
    color: var(--rose-600);
  }

  .final__top {
    margin-top: 2.2rem;
  }

  .revisit {
    margin-top: 2.6rem;
    width: 100%;
    max-width: 26rem;
  }
  .revisit__title {
    font-family: var(--font-script);
    font-size: 1.5rem;
    color: var(--rose-600);
    margin-bottom: 1rem;
  }
  .revisit__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }
  .revisit__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.9rem 0.4rem;
    border-radius: 1.2rem;
    color: var(--rose-600);
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.8);
    transition: transform 0.3s var(--ease-out), background 0.3s;
  }
  .revisit__item span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--wine);
  }
  .revisit__item:active {
    transform: scale(0.94);
    background: rgba(255, 255, 255, 0.85);
  }
  @media (hover: hover) {
    .revisit__item:hover {
      transform: translateY(-3px);
      background: rgba(255, 255, 255, 0.85);
    }
  }
</style>

<script>
  import { confetti, confettiRain, confettiCannons } from '../scripts/confetti';

  const section = document.querySelector<HTMLElement>('[data-final]');
  const heart = document.querySelector<HTMLElement>('[data-final-heart]');

  // Celebración automática, una sola vez, al llegar al final
  if (section) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        setTimeout(() => {
          confettiCannons();
          confettiRain();
        }, 400);
      },
      { threshold: 0.55 },
    );
    io.observe(section);
  }

  // …y de nuevo cada vez que toque el corazón
  heart?.addEventListener('click', () => {
    const r = heart.getBoundingClientRect();
    confetti({
      x: (r.left + r.width / 2) / window.innerWidth,
      y: (r.top + r.height / 2) / window.innerHeight,
      count: 80,
    });
  });
</script>
